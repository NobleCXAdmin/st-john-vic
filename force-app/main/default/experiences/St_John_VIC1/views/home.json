      "components": [
        {
          "componentAttributes": {
            "richTextValue": "<div style=\"background-color: #1A2536; color: #CBD5E1; padding: 48px 24px 32px 24px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; margin-top: 48px; border-top: 3px solid #007038;\">\n  <div style=\"max-width: 1140px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 36px; margin-bottom: 36px;\">\n    <div>\n      <div style=\"display: flex; align-items: center; gap: 14px; margin-bottom: 16px;\">\n        <img src=\"data:image/png;base64,\" alt=\"St John\" style=\"height: 42px; width: auto; filter: brightness(1.1);\" />\n        <div>\n          <div style=\"color: #FFFFFF; font-size: 17px; font-weight: 800; line-height: 1.2;\">St John Ambulance Victoria</div>\n          <div style=\"color: #94A3B8; font-size: 12px; margin-top: 2px;\">For the Service of Humanity</div>\n        </div>\n      </div>\n      <p style=\"font-size: 13px; color: #94A3B8; line-height: 1.6; margin: 0 0 16px 0;\">\n        St John Ambulance Victoria has been keeping Victorian event patrons safe for over 140 years through professional clinical first aid, paramedic coverage, and community volunteer service.\n      </p>\n      <div style=\"display: inline-block; background: #0F172A; border: 1px solid #334155; padding: 6px 12px; border-radius: 6px; font-size: 11px; color: #94A3B8;\">\n        ACNC Registered Charity \u2022 ABN 69 061 844 380\n      </div>\n    </div>\n    \n    <div>\n      <div style=\"color: #FFFFFF; font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 16px;\">Event Services Team</div>\n      <div style=\"font-size: 13px; line-height: 1.9; color: #CBD5E1;\">\n        <div>\ud83d\udccd <strong>State Headquarters:</strong> 601 Blackburn Rd, Notting Hill VIC 3168</div>\n        <div>\ud83d\udcde <strong>Enquiries:</strong> 1300 360 455</div>\n        <div>\u2709\ufe0f <strong>Email:</strong> events@stjohnvic.com.au</div>\n        <div>\ud83d\udd52 <strong>Operations:</strong> Mon\u2013Fri 8:30 AM \u2013 5:00 PM AEST</div>\n      </div>\n    </div>\n    \n    <div>\n      <div style=\"color: #FFFFFF; font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 16px;\">Emergency &amp; Safety Notice</div>\n      <div style=\"background: rgba(220, 38, 38, 0.12); border: 1px solid rgba(239, 68, 68, 0.35); border-radius: 8px; padding: 14px; margin-bottom: 14px;\">\n        <div style=\"color: #FCA5A5; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 2px;\">Immediate Life Threat</div>\n        <div style=\"color: #FFFFFF; font-size: 20px; font-weight: 900; letter-spacing: 0.5px;\">CALL 000</div>\n        <div style=\"color: #F87171; font-size: 12px; margin-top: 2px;\">For urgent ambulance, police or emergency response.</div>\n      </div>\n      <div style=\"font-size: 12px; color: #94A3B8; line-height: 1.5;\">\n        Submitting this enquiry does not confirm event attendance until a service proposal is accepted and confirmed by St John VIC.\n      </div>\n    </div>\n  </div>\n  \n  <div style=\"max-width: 1140px; margin: 0 auto; padding-top: 22px; border-top: 1px solid #334155; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 14px; font-size: 12px; color: #64748B;\">\n    <div>\u00a9 2026 St John Ambulance Australia (Vic) Ltd. All rights reserved.</div>\n    <div style=\"display: flex; gap: 20px;\">\n      <span>Privacy Policy</span>\n      <span>Terms of Service</span>\n      <span>Clinical Standards</span>\n    </div>\n  </div>\n</div>"
          },
