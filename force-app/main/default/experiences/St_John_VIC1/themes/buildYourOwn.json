  "customCSS": "/* St John VIC Theme Enhancements */\nbody, .siteforceContentArea, .siteforceStarterBody {\n  background-color: #F8FAFC !important;\n}\n.comm-layout-column, .siteforceContentArea {\n  padding-left: 0 !important;\n  padding-right: 0 !important;\n}\n.flowruntime-flow, .flowruntime-flow-body {\n  max-width: 840px !important;\n  margin: 0 auto 36px auto !important;\n  background-color: #FFFFFF !important;\n  border-radius: 12px !important;\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05), 0 1px 3px rgba(0, 0, 0, 0.03) !important;\n  border: 1px solid #E2E8F0 !important;\n  padding: 12px 20px !important;\n}\n.slds-button_brand, .flowruntime-flow .slds-button_brand {\n  background-color: #007038 !important;\n  border-color: #007038 !important;\n  color: #FFFFFF !important;\n  font-weight: 700 !important;\n  border-radius: 6px !important;\n  padding-left: 20px !important;\n  padding-right: 20px !important;\n  transition: all 0.2s ease-in-out !important;\n}\n.slds-button_brand:hover, .flowruntime-flow .slds-button_brand:hover {\n  background-color: #005A2B !important;\n  border-color: #005A2B !important;\n  box-shadow: 0 2px 8px rgba(0, 112, 56, 0.25) !important;\n}\n.slds-button_neutral, .flowruntime-flow .slds-button_neutral {\n  border-radius: 6px !important;\n  font-weight: 600 !important;\n  color: #334155 !important;\n  border-color: #CBD5E1 !important;\n}\n.slds-input:focus, .slds-textarea:focus, .slds-select:focus {\n  border-color: #007038 !important;\n  box-shadow: 0 0 0 2px rgba(0, 112, 56, 0.15) !important;\n}",
