    <description>Public Experience Cloud Screen Flow for capturing St John VIC event booking enquiries and initiating the BDM qualification lifecycle.</description>
    <environments>Default</environments>
    <formulas>
        <name>formulaIsMultiDay</name>
        <dataType>Boolean</dataType>
        <expression>{!Start_Date} &lt;&gt; {!End_Date}</expression>
    </formulas>
    <formulas>
        <name>formulaLeadCompany</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Organisation_Name}), {!First_Name} &amp; &quot; &quot; &amp; {!Last_Name}, {!Organisation_Name})</expression>
    </formulas>
    <formulas>
        <name>formulaLeadDescription</name>
        <dataType>String</dataType>
        <expression>&quot;Event Enquiry: &quot; &amp; {!Event_Name} &amp; &quot; (&quot; &amp; {!Event_Type_Select} &amp; &quot;). Venue: &quot; &amp; {!Venue_Name} &amp; &quot;. Expected Crowd: &quot; &amp; TEXT({!Expected_Attendance}) &amp; &quot; attendees.&quot;</expression>
    </formulas>
    <formulas>
        <name>formulaLeadSource</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Lead_Source_Select}), &quot;Website&quot;, {!Lead_Source_Select})</expression>
    </formulas>
    <formulas>
        <name>formulaSubKey</name>
        <dataType>String</dataType>
        <expression>"FLOW-" &amp; TEXT({!$Flow.CurrentDateTime})</expression>
    </formulas>
    <formulas>
        <name>formulaTaskSubject</name>
        <dataType>String</dataType>
        <expression>"Follow up new event enquiry: " &amp; {!Event_Name}</expression>
    </formulas>
    <formulas>
        <name>formulaTomorrow</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} + 1</expression>
    </formulas>
    <interviewLabel>St John Event Booking Enquiry {!$Flow.CurrentDateTime}</interviewLabel>
    <isAdditionalPermissionRequiredToRun>true</isAdditionalPermissionRequiredToRun>
